---
import { getEntry, render } from "astro:content";
import type { HomeSection } from "../../lib/home";

interface Props {
  seccion: HomeSection;
  numero: string;
}

const { seccion, numero } = Astro.props;
const inicio = await getEntry("paginas", "inicio");

if (!inicio) {
  throw new Error("Falta el contenido institucional de inicio.");
}

const { Content: Intro } = await render(inicio);
---

<section
  id={seccion.id}
  class="home-manifesto section"
  aria-labelledby={`${seccion.id}-title`}
>
  <div class="container home-manifesto__grid">
    <p class="eyebrow">
      <span class="eyebrow__index">{numero}</span>
      <span>{seccion.label}</span>
    </p>

    <div class="home-manifesto__content">
      <h2
        id={`${seccion.id}-title`}
        class="home-manifesto__quote"
        set:html={`«${inicio.data.manifesto ?? ""}»`}
      />
      <div class="home-manifesto__text">
        <Intro />
      </div>
    </div>
  </div>
</section>

<style>
  .home-manifesto {
    padding-block: var(--space-2xl);
  }

  .home-manifesto__grid {
    display: grid;
    grid-template-columns: minmax(10rem, 0.3fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    align-items: start;
  }

  .home-manifesto__content {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
  }

  .home-manifesto__quote {
    max-width: 20ch;
    font-size: var(--display-sm);
    line-height: 0.98;
    color: var(--ink);
  }

  .home-manifesto__quote :global(.accent) {
    color: var(--ochre-deep);
  }

  .home-manifesto__text {
    max-width: 52ch;
    display: grid;
    gap: 1em;
    padding-top: 0.4rem;
    font-size: var(--text-base);
    color: var(--ink-soft);
  }

  @media (max-width: 1100px) {
    .home-manifesto__content {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    .home-manifesto__quote {
      max-width: 16ch;
    }
  }

  @media (max-width: 900px) {
    .home-manifesto__grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }
</style>
