---
import { getEntry } from "astro:content";
import { url } from "../../lib/url";
import type { HomeSection } from "../../lib/home";

interface Props {
  seccion: HomeSection;
  numero: string;
}

const { seccion, numero } = Astro.props;
const acerca = await getEntry("paginas", "acerca");

if (!acerca) {
  throw new Error("Falta el contenido institucional de acerca.");
}

const principios = acerca.data.principles.slice(0, 4);
---

<section
  id={seccion.id}
  class="home-field surface-dark section"
  aria-labelledby={`${seccion.id}-title`}
>
  <div class="container home-field__grid">
    <div class="home-field__lead">
      <p class="eyebrow">
        <span class="eyebrow__index">{numero}</span>
        <span>{seccion.label}</span>
      </p>
      <h2
        id={`${seccion.id}-title`}
        class="home-field__title"
        set:html={seccion.title ?? ""}
      />
      {seccion.text && <p class="home-field__text">{seccion.text}</p>}
      {
        seccion.linkHref && seccion.linkLabel && (
          <a class="link-arrow" href={url(seccion.linkHref)}>
            {seccion.linkLabel}
          </a>
        )
      }
    </div>

    <div class="home-field__principles">
      {seccion.principlesLabel && (
        <p class="label">{seccion.principlesLabel}</p>
      )}
      <ol>
        {
          principios.map((principio, index) => (
            <li>
              <span class="home-field__num" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              <div>
                <h3>{principio.title}</h3>
                <p>{principio.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
      {
        seccion.aside && (
          <p class="home-field__aside">
            {seccion.aside}{" "}
            {seccion.asideLinkHref && seccion.asideLinkLabel && (
              <a href={url(seccion.asideLinkHref)}>
                {seccion.asideLinkLabel}
              </a>
            )}
          </p>
        )
      }
    </div>
  </div>
</section>

<style>
  .home-field {
    position: relative;
    overflow: hidden;
  }

  .home-field::before {
    content: "";
    position: absolute;
    right: -12vw;
    top: -18vw;
    width: 42vw;
    height: 42vw;
    border: 1px solid var(--line-dark);
    border-radius: 50%;
    pointer-events: none;
  }

  .home-field__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .home-field__title {
    max-width: 11ch;
    margin-top: var(--space-md);
    font-size: var(--display-sm);
    line-height: 0.98;
  }

  .home-field__text {
    max-width: 42ch;
    margin-top: var(--space-md);
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--dark-muted);
  }

  .home-field__lead :global(.link-arrow) {
    margin-top: var(--space-lg);
  }

  .home-field__principles {
    padding-top: 0.3rem;
  }

  .home-field__principles .label {
    color: var(--ochre-soft);
    display: block;
    margin-bottom: var(--space-md);
  }

  .home-field__principles ol {
    display: grid;
  }

  .home-field__principles li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: var(--space-sm);
    padding-block: var(--space-sm);
    border-top: 1px solid var(--line-dark);
  }

  .home-field__principles li:last-child {
    border-bottom: 1px solid var(--line-dark);
  }

  .home-field__num {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--ochre-soft);
    padding-top: 0.2rem;
  }

  .home-field__principles h3 {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0;
    color: var(--dark-ink);
  }

  .home-field__principles p {
    margin-top: 0.25rem;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--dark-muted);
  }

  .home-field__aside {
    margin-top: var(--space-md);
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--dark-muted);
  }

  .home-field__aside a {
    color: var(--ochre-soft);
  }

  @media (max-width: 900px) {
    .home-field__grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }
</style>
