---
import { getCollection } from "astro:content";
import SectionHeading from "../SectionHeading.astro";
import ProjectEntry from "../ProjectEntry.astro";
import type { HomeSection } from "../../lib/home";

interface Props {
  seccion: HomeSection;
  numero: string;
}

const { seccion, numero } = Astro.props;

const proyectos = (await getCollection("proyectos")).sort(
  (a, b) => a.data.order - b.data.order,
);
const destacados = proyectos.filter((project) => project.data.featured);
---

<section
  id={seccion.id}
  class="section"
  aria-labelledby={`${seccion.id}-title`}
>
  <div class="container">
    <SectionHeading
      index={numero}
      label={seccion.label}
      title={seccion.title}
      titleId={`${seccion.id}-title`}
      href={seccion.linkHref}
      linkLabel={seccion.linkLabel}
    >
      {seccion.note && <p class="section-note">{seccion.note}</p>}
    </SectionHeading>

    <div class="home-projects">
      {
        destacados.map((project, index) => (
          <ProjectEntry
            project={project}
            layout={index < 2 ? "featured" : "wide"}
            number={project.data.order}
          />
        ))
      }
    </div>
  </div>
</section>

<style>
  .home-projects {
    display: grid;
    min-width: 0;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 4rem) var(--grid-gap);
  }

  .home-projects > :global(*) {
    min-width: 0;
  }

  .home-projects > :global(:nth-child(1)) {
    grid-column: span 7;
  }

  .home-projects > :global(:nth-child(2)) {
    grid-column: span 5;
    margin-top: 7rem;
  }

  .home-projects > :global(:nth-child(3)) {
    grid-column: 1 / -1;
    margin-top: var(--space-md);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--line);
  }

  @media (max-width: 1100px) {
    .home-projects > :global(:nth-child(2)) {
      margin-top: 4rem;
    }
  }

  @media (max-width: 1120px) {
    .home-projects {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }

    .home-projects > :global(:nth-child(1)),
    .home-projects > :global(:nth-child(2)),
    .home-projects > :global(:nth-child(3)) {
      grid-column: 1;
      margin-top: 0;
      padding-top: 0;
      border-top: 0;
    }

    .home-projects > :global(:nth-child(2)),
    .home-projects > :global(:nth-child(3)) {
      padding-top: var(--space-xl);
      border-top: 1px solid var(--line);
    }
  }

  @media (max-width: 900px) {
    .home-projects {
      grid-template-columns: 1fr;
    }

    .home-projects > :global(:nth-child(1)),
    .home-projects > :global(:nth-child(2)),
    .home-projects > :global(:nth-child(3)) {
      grid-column: 1;
      margin-top: 0;
      padding-top: 0;
      border-top: 0;
    }

    .home-projects > :global(:nth-child(2)) {
      padding-top: var(--space-xl);
      border-top: 1px solid var(--line);
    }

    .home-projects > :global(:nth-child(3)) {
      padding-top: var(--space-xl);
      border-top: 1px solid var(--line);
    }
  }
</style>
