---
import { sitio } from "../../data/sitio";
import { url } from "../../lib/url";
import type { HomeSection } from "../../lib/home";

interface Props {
  seccion: HomeSection;
  numero: string;
}

const { seccion, numero } = Astro.props;
---

<section
  id={seccion.id}
  class="home-contact section"
  aria-labelledby={`${seccion.id}-title`}
>
  <div class="container home-contact__grid">
    <div>
      <p class="eyebrow">
        <span class="eyebrow__index">{numero}</span>
        <span>{seccion.label}</span>
      </p>
      <h2 id={`${seccion.id}-title`} class="home-contact__title">
        {seccion.title}
      </h2>
    </div>
    <div class="home-contact__body">
      {seccion.text && <p>{seccion.text}</p>}
      <a class="home-contact__email" href={`mailto:${sitio.email}`}>
        {sitio.email}
      </a>
      {
        seccion.linkHref && seccion.linkLabel && (
          <a class="link-arrow" href={url(seccion.linkHref)}>
            {seccion.linkLabel}
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .home-contact {
    border-top: 1px solid var(--line);
    padding-top: var(--space-2xl);
  }

  .home-contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: end;
  }

  .home-contact__title {
    max-width: 13ch;
    margin-top: var(--space-md);
    font-size: var(--display-sm);
    line-height: 0.98;
  }

  .home-contact__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    padding-bottom: 0.45rem;
  }

  .home-contact__body p {
    max-width: 38ch;
    color: var(--ink-muted);
  }

  .home-contact__email {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1;
    text-decoration: none;
    color: var(--ochre-deep);
    border-bottom: 1px solid var(--ochre);
  }

  .home-contact__email:hover {
    color: var(--ink);
    border-color: var(--ink);
  }

  @media (max-width: 900px) {
    .home-contact__grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }
</style>
