---
import type { CollectionEntry } from "astro:content";
import ProjectPlate from "./ProjectPlate.astro";
import { url } from "../lib/url";

interface Props {
  experiment: CollectionEntry<"experimentos">;
  index: number;
}

const { experiment, index } = Astro.props;
const data = experiment.data;
const num = String(index).padStart(2, "0");
---

<a class="experiment-row" href={url(`/experimentos/${experiment.id}/`)}>
  <span class="experiment-row__index" aria-hidden="true">{num}</span>

  <span class="experiment-row__plate">
    <ProjectPlate variant={data.plate} seed={data.seed} label={`/ ${num}`} />
  </span>

  <span class="experiment-row__main">
    <span class="experiment-row__title">{data.title}</span>
    <span class="experiment-row__summary">{data.summary}</span>
  </span>

  <span class="experiment-row__meta">
    <span>{data.type}</span>
    <span class="experiment-row__status">{data.status}</span>
    <span>{data.year}</span>
  </span>

  <span class="experiment-row__arrow" aria-hidden="true">↗</span>
</a>

<style>
  .experiment-row {
    display: grid;
    grid-template-columns: 2rem 9rem minmax(0, 1fr) 13rem 1.5rem;
    gap: var(--space-md);
    align-items: center;
    padding-block: var(--space-md);
    border-top: 1px solid var(--line);
    text-decoration: none;
    color: var(--ink);
    transition: background-color var(--dur) var(--ease);
  }

  .experiment-row:last-child {
    border-bottom: 1px solid var(--line);
  }

  .experiment-row:hover {
    color: var(--ink);
    background: rgba(183, 122, 53, 0.035);
  }

  .experiment-row__index {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ochre-deep);
  }

  .experiment-row__plate {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .experiment-row__main {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .experiment-row__title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: 1;
    letter-spacing: var(--tracking-display);
  }

  .experiment-row__summary {
    max-width: 52ch;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .experiment-row__meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
    line-height: 1.4;
  }

  .experiment-row__status {
    color: var(--ochre-deep);
  }

  .experiment-row__arrow {
    font-size: 1.3rem;
    line-height: 1;
    color: var(--ochre-deep);
    transition: transform var(--dur) var(--ease);
  }

  .experiment-row:hover .experiment-row__arrow {
    transform: translate(0.2rem, -0.2rem);
  }

  @media (max-width: 1000px) {
    .experiment-row {
      grid-template-columns: 1.75rem 7rem minmax(0, 1fr) 1.2rem;
      gap: var(--space-sm);
    }

    .experiment-row__meta {
      grid-column: 3;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.35rem 0.75rem;
    }

    .experiment-row__arrow {
      grid-column: 4;
      grid-row: 1 / span 2;
    }
  }

  @media (max-width: 620px) {
    .experiment-row {
      grid-template-columns: 1.5rem minmax(0, 1fr) 1.2rem;
      gap: 0.6rem;
      align-items: start;
    }

    .experiment-row__plate {
      display: none;
    }

    .experiment-row__index {
      grid-column: 1;
      grid-row: 1 / span 2;
      padding-top: 0.35rem;
    }

    .experiment-row__main {
      grid-column: 2;
    }

    .experiment-row__meta {
      grid-column: 2;
    }

    .experiment-row__arrow {
      grid-column: 3;
      grid-row: 1 / span 2;
    }

    .experiment-row__summary {
      font-size: var(--text-xs);
    }
  }
</style>
