---
interface Props {
  size?: number | string;
  title?: string;
  class?: string;
}

const { size = 28, title, class: className = "" } = Astro.props;

const width = typeof size === "number" ? Math.round((size * 2) / 3) : size;
---

<svg
  class:list={["mark", className]}
  width={width}
  height={size}
  viewBox="0 0 100 150"
  fill="none"
  role={title ? "img" : undefined}
  aria-hidden={title ? undefined : "true"}
  focusable="false"
>
  {title && <title>{title}</title>}
  <g
    stroke="currentColor"
    stroke-width="3.1"
    stroke-linecap="butt"
    stroke-linejoin="round"
  >
    <path d="M50 0V150"></path>
    <path d="M50 31C50 54 37 76 10 88"></path>
    <path d="M50 31C50 54 63 76 90 88"></path>
  </g>
</svg>

<style>
  .mark {
    overflow: visible;
    flex: none;
  }
</style>
