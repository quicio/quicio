---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt?: string;
  sizes?: string;
  widths?: number[];
  loading?: "lazy" | "eager";
  class?: string;
}

const {
  src,
  alt = "",
  sizes = "(max-width: 900px) 100vw, (max-width: 1120px) 60vw, 42vw",
  widths = [480, 720, 1000],
  loading = "lazy",
  class: className = "",
} = Astro.props;
---

<Image
  class:list={["entry-image", className]}
  src={src}
  alt={alt}
  widths={widths}
  sizes={sizes}
  format="webp"
  quality={82}
  loading={loading}
/>

<style>
  .entry-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
</style>
