---
import Base from "../../layouts/Base.astro";
import ProjectPlate from "../../components/ProjectPlate.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const archivo = await getCollection("archivo");
  return archivo.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"archivo">;
}

const { entry } = Astro.props;
const data = entry.data;
const { Content } = await render(entry);
const num = String(data.order).padStart(2, "0");
---

<Base title={data.title} description={data.summary} type="article">
  <article class="archive-entry">
    <div class="container">
      <a class="archive-entry__back" href="/archivo/">
        <span aria-hidden="true">←</span> Archivo
      </a>

      <header class="archive-entry__header">
        <div class="archive-entry__intro">
          <p class="eyebrow">
            <span class="eyebrow__index">{num}</span>
            <span>{data.kind}</span>
          </p>
          <h1 class="archive-entry__title">{data.title}</h1>
          <p class="archive-entry__lead">{data.summary}</p>

          <dl class="archive-entry__meta">
            <div>
              <dt>Año</dt>
              <dd>{data.year}</dd>
            </div>
            <div>
              <dt>Tipo</dt>
              <dd>{data.kind}</dd>
            </div>
            <div>
              <dt>Estado</dt>
              <dd class="archive-entry__state">{data.state}</dd>
            </div>
          </dl>

          {
            data.artifact && (
              <a
                class="archive-entry__artifact link-arrow"
                href={data.artifact}
                target="_blank"
                rel="noreferrer"
              >
                {data.linkLabel}
              </a>
            )
          }
        </div>

        <div class="archive-entry__plate">
          <ProjectPlate
            variant={data.plate}
            seed={data.seed}
            label={`/ ${num}`}
          />
        </div>
      </header>

      <div class="archive-entry__body prose">
        <Content />
      </div>

      <aside class="archive-entry__note">
        <p class="label">Nota de archivo</p>
        <p>
          Los artefactos se conservan tal como fueron publicados. Pueden
          contener enlaces externos, tipografías o scripts que ya no forman parte
          del sitio actual.
        </p>
      </aside>
    </div>
  </article>
</Base>

<style>
  .archive-entry {
    padding-block: var(--space-lg) var(--space-2xl);
  }

  .archive-entry__back {
    display: inline-block;
    margin-bottom: var(--space-lg);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-muted);
  }

  .archive-entry__back:hover {
    color: var(--ochre-deep);
  }

  .archive-entry__header {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid var(--line);
  }

  .archive-entry__title {
    margin-top: var(--space-md);
    font-size: var(--display);
    line-height: 0.84;
  }

  .archive-entry__lead {
    max-width: 44ch;
    margin-top: var(--space-md);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-style: italic;
    line-height: 1.15;
    color: var(--ink-soft);
  }

  .archive-entry__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md) var(--space-xl);
    margin-top: var(--space-lg);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--line-soft);
  }

  .archive-entry__meta dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .archive-entry__meta dd {
    margin-top: 0.25rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-soft);
  }

  .archive-entry__state {
    color: var(--ochre-deep) !important;
  }

  .archive-entry__artifact {
    margin-top: var(--space-lg);
  }

  .archive-entry__plate {
    aspect-ratio: 4 / 3.2;
  }

  .archive-entry__body {
    margin-top: var(--space-xl);
    margin-left: auto;
    margin-right: auto;
    padding-block: var(--space-lg);
  }

  .archive-entry__note {
    max-width: 52ch;
    margin-left: auto;
    margin-right: auto;
    padding-top: var(--space-md);
    border-top: 1px solid var(--line);
  }

  .archive-entry__note .label {
    color: var(--ochre-deep);
  }

  .archive-entry__note p:last-child {
    margin-top: var(--space-sm);
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--ink-muted);
  }

  @media (max-width: 900px) {
    .archive-entry__header {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .archive-entry__title {
      font-size: clamp(3.6rem, 18vw, 6rem);
    }

    .archive-entry__plate {
      aspect-ratio: 4 / 3;
    }
  }
</style>
