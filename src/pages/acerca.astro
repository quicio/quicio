---
import Base from "../layouts/Base.astro";
import { getEntry, render } from "astro:content";
import { sitio } from "../data/sitio";
import { url } from "../lib/url";

const acerca = await getEntry("paginas", "acerca");

if (!acerca) {
  throw new Error("Falta el contenido de la página Acerca.");
}

const { Content } = await render(acerca);
const principios = acerca.data.principles;
---

<Base
  title="Acerca"
  description={acerca.data.description}
  image="/og.png"
>
  <header class="about-hero">
    <div class="container about-hero__grid">
      <div class="about-hero__intro">
        <p class="eyebrow">
          <span class="eyebrow__index">01</span>
          <span>{acerca.data.eyebrow}</span>
        </p>
        <h1 class="about-hero__title">{acerca.data.title}</h1>
        <p class="about-hero__lead">{acerca.data.lead}</p>
      </div>

      <aside class="about-fiche" aria-label="Ficha del estudio">
        <p class="about-fiche__label label">Ficha</p>
        <dl>
          <div>
            <dt>Naturaleza</dt>
            <dd>Estudio independiente</dd>
          </div>
          <div>
            <dt>Campo</dt>
            <dd>Software, publicaciones, investigación, arte, música</dd>
          </div>
          <div>
            <dt>Base</dt>
            <dd>{sitio.lugar}</dd>
          </div>
          <div>
            <dt>Contacto</dt>
            <dd><a href={`mailto:${sitio.email}`}>{sitio.email}</a></dd>
          </div>
        </dl>
        <p class="about-fiche__note">
          Sin equipo comercial. Sin estructura de agencia.
        </p>
      </aside>
    </div>
  </header>

  <section class="about-principles section" aria-labelledby="principios-title">
    <div class="container">
      <div class="about-principles__head">
        <p class="eyebrow">
          <span class="eyebrow__index">02</span>
          <span>Principios</span>
        </p>
        <h2 id="principios-title">Ocho formas de sostener el trabajo.</h2>
      </div>

      <ol class="about-principles__grid">
        {
          principios.map((principio, index) => (
            <li>
              <span class="about-principles__num" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              <h3>{principio.title}</h3>
              <p>{principio.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="about-body section" aria-labelledby="relato-title">
    <div class="container about-body__grid">
      <div class="about-body__aside">
        <p class="eyebrow">
          <span class="eyebrow__index">03</span>
          <span>El estudio</span>
        </p>
        <p class="about-body__quote">
          «No todo lo que hacemos tiene que convertirse en un producto.»
        </p>
        <p class="about-body__coordinates mono">
          {sitio.lugar}<br />{sitio.coordenadas}
        </p>
      </div>

      <div class="about-body__content prose">
        <h2 id="relato-title" class="visually-hidden">Qué es Quicio</h2>
        <Content />
      </div>
    </div>
  </section>

  <section class="about-close section" aria-labelledby="about-close-title">
    <div class="container about-close__grid">
      <div>
        <p class="eyebrow">
          <span class="eyebrow__index">04</span>
          <span>Colaboración</span>
        </p>
        <h2 id="about-close-title">
          La puerta está abierta, pero no es una agencia.
        </h2>
      </div>
      <div class="about-close__body">
        <p>
          Quicio está abierto a conversaciones, colaboraciones y proyectos que
          encuentren aquí un lugar. No hay una estructura comercial ni un
          equipo ficticio.
        </p>
        <a class="link-arrow" href={url("/contacto/")}>Escribir a Quicio</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .about-hero {
    padding-block: var(--space-xl) var(--space-2xl);
    border-bottom: 1px solid var(--line);
  }

  .about-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(15rem, 0.65fr);
    gap: clamp(2rem, 7vw, 7rem);
    align-items: end;
  }

  .about-hero__title {
    max-width: 13ch;
    margin-top: var(--space-md);
    font-size: var(--display);
    line-height: 0.82;
  }

  .about-hero__lead {
    max-width: 42ch;
    margin-top: var(--space-md);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-style: italic;
    line-height: 1.05;
    color: var(--ochre-deep);
  }

  .about-fiche {
    padding-top: var(--space-sm);
    border-top: 1px solid var(--line-strong);
  }

  .about-fiche__label {
    color: var(--ochre-deep);
  }

  .about-fiche dl {
    margin-top: var(--space-sm);
  }

  .about-fiche dl > div {
    padding-block: 0.55rem;
    border-top: 1px solid var(--line-soft);
  }

  .about-fiche dl > div:last-child {
    border-bottom: 1px solid var(--line-soft);
  }

  .about-fiche dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .about-fiche dd {
    margin-top: 0.2rem;
    font-size: var(--text-sm);
    line-height: 1.45;
    color: var(--ink-soft);
  }

  .about-fiche__note {
    margin-top: var(--space-sm);
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .about-principles__head {
    display: grid;
    grid-template-columns: minmax(10rem, 0.3fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    align-items: start;
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--line);
  }

  .about-principles__head h2 {
    max-width: 16ch;
    font-size: var(--display-sm);
  }

  .about-principles__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 var(--space-xl);
    margin-top: var(--space-lg);
  }

  .about-principles__grid li {
    display: grid;
    grid-template-columns: 2.2rem minmax(0, 1fr);
    gap: 0 var(--space-sm);
    padding-block: var(--space-md);
    border-top: 1px solid var(--line);
  }

  .about-principles__num {
    grid-row: 1 / span 2;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--ochre-deep);
    padding-top: 0.25rem;
  }

  .about-principles__grid h3 {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.3;
  }

  .about-principles__grid p {
    margin-top: 0.3rem;
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--ink-muted);
  }

  .about-body {
    border-top: 1px solid var(--line);
  }

  .about-body__grid {
    display: grid;
    grid-template-columns: minmax(12rem, 0.34fr) minmax(0, 1fr);
    gap: clamp(2rem, 7vw, 7rem);
    align-items: start;
  }

  .about-body__aside {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .about-body__quote {
    max-width: 15ch;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-style: italic;
    line-height: 1.1;
    color: var(--ochre-deep);
  }

  .about-body__coordinates {
    color: var(--ink-muted);
    line-height: 1.5;
  }

  .about-body__content {
    max-width: 62ch;
  }

  .about-body__content :global(h2) {
    font-size: var(--text-xl);
    margin-top: 1.8em;
  }

  .about-body__content :global(h2:first-child) {
    margin-top: 0;
  }

  .about-body__content :global(p + p) {
    margin-top: 1.1em;
  }

  .about-close {
    border-top: 1px solid var(--line);
  }

  .about-close__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: end;
  }

  .about-close h2 {
    max-width: 14ch;
    margin-top: var(--space-md);
    font-size: var(--display-sm);
  }

  .about-close__body p {
    max-width: 40ch;
    color: var(--ink-muted);
  }

  .about-close__body :global(.link-arrow) {
    margin-top: var(--space-md);
  }

  @media (max-width: 1000px) {
    .about-hero__grid,
    .about-close__grid {
      grid-template-columns: 1fr;
    }

    .about-principles__head,
    .about-body__grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .about-body__aside {
      position: static;
    }
  }

  @media (max-width: 760px) {
    .about-principles__grid {
      grid-template-columns: 1fr;
    }

    .about-hero__title {
      font-size: clamp(3.6rem, 17vw, 6rem);
    }
  }
</style>
